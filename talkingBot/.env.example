# =========================================================
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file or share it publicly.
# =========================================================

# Get a free key from https://console.groq.com -> API Keys -> Create Key
GROQ_API_KEY=KEY

# Chat model used to generate the AI answer
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Model used for speech-to-text (runs on Groq's servers, no local install needed)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# How many seconds to record the question for
RECORDING_SECONDS=5

# ---------------------------------------------------------
# ESP32 (WiFi edition - esp32/esp32_wifi_led.ino)
# ---------------------------------------------------------
# The ESP32's IP address on your WiFi network. After flashing the
# sketch, open the Arduino Serial Monitor once (115200 baud) and
# copy the "IP address: ..." line it prints, e.g. 192.168.1.42
#
# You can also try ESP32_IP=talkingbot.local (mDNS) - works on Mac/
# Linux by default; on Windows you may need Bonjour/iTunes installed.
# If that doesn't work, just use the numeric IP instead.
ESP32_IP=192.168.7.123


# How long (seconds) to wait for a reply from the ESP32 before giving
# up and continuing voice-only. Raise this a little on a slow/crowded
# WiFi network.
ESP32_HTTP_TIMEOUT=2

# If true, the bot refuses to answer when the ESP32 isn't reachable
# on WiFi. Keep this "false" so the bot still works (voice-only) even
# if the ESP32 is off or out of WiFi range.
REQUIRE_ESP32=false
